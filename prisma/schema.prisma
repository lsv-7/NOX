datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  NEW
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  NOT_SENT
  SENT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Order {
  id                 String             @id @default(uuid())
  orderId            String             @unique // Human-readable e.g., NOX-00001
  customerName       String
  phone              String
  address            String
  pincode            String
  quantity           Int
  amount             Int                // Stored in paise (e.g. ₹999 = 99900)
  paymentStatus      PaymentStatus      @default(PENDING)
  paymentId          String?            // Razorpay payment ID
  razorpayOrderId    String             @unique // Razorpay order ID
  orderStatus        OrderStatus        @default(NEW)
  notificationStatus NotificationStatus @default(PENDING)
  deliveryStatus     DeliveryStatus     @default(NOT_SENT)
  customerId         String?
  customer           Customer?          @relation(fields: [customerId], references: [id])
  items              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Customer {
  id                 String    @id @default(uuid())
  name               String
  phone              String    @unique
  email              String    @unique
  passwordHash       String
  passwordChangedAt  DateTime  @default(now())
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  orders             Order[]
}

model OrderCounter {
  id      Int @id @default(1)
  counter Int @default(0)
}
